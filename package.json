{
  "name": "yamb-hono",
  "version": "0.1.1",
  "private": true,
  "description": "A local Yamb blog on Hono and Node.js",
  "keywords": [
    "blog",
    "example",
    "hono",
    "markdown",
    "yamb"
  ],
  "license": "MIT",
  "author": {
    "name": "Alexey Simonenko",
    "email": "alexey@simonenko.dev",
    "url": "https://simonenko.xyz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yamb/yamb-hono.git"
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --test 'test/**/*.test.js'",
    "start": "node server.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "hono": "4.13.21",
    "yamb": "1.1.0",
    "yamb-markdown": "0.1.5",
    "yamb-render-html": "0.1.3",
    "yamb-storage-files": "0.2.0"
  },
  "devDependencies": {
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "packageManager": "pnpm@12.23.0"
}
